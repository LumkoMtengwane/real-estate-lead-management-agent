# Variable names only. Copy to .env and paste real values there. Never commit .env.
# In production (Trigger.dev) set the same variables as Secrets in the dashboard.

# Anthropic API key (console.anthropic.com). Pay-per-use, separate from the Claude subscription.
ANTHROPIC_API_KEY=

# Google OAuth client (Google Cloud console, Desktop app) and a refresh token for the agency inbox.
# Scopes: gmail.readonly, gmail.compose, calendar.freebusy. Run scripts/google_auth.py to get the token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Google service account JSON key, base64-encoded on ONE line (used for the Sheet only).
# PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
GOOGLE_SERVICE_ACCOUNT_B64=
# ID of the Sheet (long part of its URL between /d/ and /edit). Share it with the service account email as Editor.
GOOGLE_SHEET_ID=

# HubSpot private app token (HubSpot > Settings > Integrations > Private apps). Free CRM is enough.
HUBSPOT_TOKEN=

# Who receives hot-lead and failure alerts. The agent only ever emails this address. Customers get drafts, never sent mail.
OWNER_EMAIL=
